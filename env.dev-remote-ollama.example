# Dev no seu PC → Ollama na VPS (banco continua MongoDB de produção — cuidado)
# Copie as linhas que precisar para o seu .env local (não commitar .env).

# 1) Em outro terminal, abra o túnel SSH (deixe rodando):
#    Docker Ollama na VPS (porta host 11435):
#      ssh -N -L 11435:127.0.0.1:11435 root@31.97.93.86
#      ssh -N -L 11435:127.0.0.1:11435 root@srv1192543.hstgr.cloud
#    (srv1192543 sozinho NÃO resolve — é só o nome no prompt dentro da VPS)
#    Ou Ollama no host (porta 11434):
#      ssh -N -L 11434:127.0.0.1:11434 root@31.97.93.86

OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_API_KEY=mesmo_valor_do_env_docker_na_VPS
OLLAMA_USE_MODELFILE=1
OLLAMA_MODEL=orion-ai
OLLAMA_PLAN_MODEL=llama3.2:3b
OLLAMA_BASE_MODEL=llama3.2:3b

# Timeouts maiores (rede + fila na VPS)
OLLAMA_PLAN_TIMEOUT_MS=300000
OLLAMA_CHAT_TIMEOUT_MS=180000
OLLAMA_APP_MAX_CONCURRENT=2
OLLAMA_QUEUE_MAX_WAIT_MS=120000

# Resto igual ao que você já usa (DATABASE_URL, JWT_SECRET, etc.)
