# Dev local — copie trechos para .env (não commitar .env)

# Ollama no seu PC (instale: https://ollama.com)
OLLAMA_URL=http://127.0.0.1:11434
# Testes locais (pouca RAM): ollama pull llama3.2:1b
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PLAN_MODEL=llama3.2:1b
OLLAMA_USE_MODELFILE=0
# VPS/produção usa llama3.2:3b — local: ollama pull llama3.2:3b OU ajuste o .env

OLLAMA_PLAN_TIMEOUT_MS=180000
OLLAMA_CHAT_TIMEOUT_MS=120000
# 1B models: more tokens for full JSON (optional)
OLLAMA_PLAN_NUM_PREDICT=750

# VPS via túnel (opcional): docs/DEV-REMOTE-OLLAMA.md
