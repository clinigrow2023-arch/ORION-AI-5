# Copie para .env.docker na VPS (não commitar):
#   cp env.docker.example .env.docker

# --- App (container orion-app) ---
ORION_APP_HOST_PORT=3001
SITE_URL=https://seu-dominio-novo.com

DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/orionai
JWT_SECRET=change-me

GMAIL_USER=
GMAIL_PASS=
VITE_SUPPORT_EMAIL=

DIGISTORE_IPN_PASSPHRASE=
DIGISTORE_ALLOWED_PRODUCT_IDS=686819,686820,683588,686804

# --- Ollama SEPARADO (container orion-ollama) ---
# Não altera o Ollama de produção no host (porta 11434).
OLLAMA_ORION_HOST_PORT=11435
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=

# --- Deploy script (opcional) ---
# ORION_REPO_URL=https://github.com/clinigrow2023-arch/ORION-AI-5.git
# ORION_GIT_BRANCH=feature/vps-ollama-only
# ORION_INSTALL_DIR=/opt/orion-ai-docker
