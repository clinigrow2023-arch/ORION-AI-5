# Copie para .env.docker na VPS (não commitar): cp env.docker.example .env.docker
# Preencha com os mesmos valores do .env do projeto.

ORION_APP_HOST_PORT=3001
SITE_URL=http://SEU_IP_OU_DOMINIO:3001

DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/orionai?appName=OrionIA
JWT_SECRET=

GMAIL_USER=
# Aspas obrigatórias se a senha tiver espaços:
GMAIL_PASS=""
VITE_SUPPORT_EMAIL=

DIGISTORE_IPN_PASSPHRASE=
DIGISTORE_ALLOWED_PRODUCT_IDS=686819,686820,683588,686804

OLLAMA_ORION_HOST_PORT=11435
OLLAMA_USE_MODELFILE=1
OLLAMA_BASE_MODEL=llama3.2:3b
OLLAMA_MODEL=orion-ai
OLLAMA_PLAN_MODEL=llama3.2:3b
OLLAMA_NUM_PARALLEL=8
OLLAMA_API_KEY=

ORION_REPO_URL=https://github.com/clinigrow2023-arch/ORION-AI-5.git
ORION_GIT_BRANCH=feature/vps-ollama-only
ORION_INSTALL_DIR=/opt/orion-ai-docker
