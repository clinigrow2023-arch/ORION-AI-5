// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String   @unique
  password            String
  role                String   @default("user") // "user" or "admin"
  isBlocked           Boolean  @default(false)
  isActive            Boolean  @default(false) // Usuário precisa ser liberado manualmente
  accessExpiresAt     DateTime? // Data de expiração do acesso (1 mês após liberação)
  passwordResetRequired Boolean @default(false) // Flag para indicar que senha precisa ser redefinida

  // Idioma preferido: usado na UI, nas respostas da IA e nos e-mails.
  // Opcional para tolerar documentos criados antes do i18n (null = "en").
  locale              String?  @default("en") // "en" | "fr"
  
  // Campos de assinatura DigiStore
  digistoreOrderId    String?  // ID do pedido na DigiStore
  subscriptionStatus  String?  // "active", "cancelled", "payment_missed", "refunded", "chargeback"
  lastPaymentDate     DateTime? // Data do último pagamento
  nextPaymentDate     DateTime? // Próxima data de pagamento (para assinaturas recorrentes)
  productId           String?  // ID do produto comprado
  billingType         String?  // "one_time", "recurring", etc
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  conversations Conversation[]

  @@map("users")
  @@index([digistoreOrderId])
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  String   // JSON array de mensagens
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
  @@index([userId])
}

model SystemPrompt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  prompt    String   // System instruction para todas as IAs
  version   Int      @default(1) // Versão do prompt para controle
  updatedBy String?  // ID do admin que atualizou
  // Idioma do prompt. Opcional porque registros criados antes do i18n não
  // possuem o campo; nesses casos o valor ausente é tratado como "en".
  locale    String?  @default("en") // "en" | "fr"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_prompts")
  @@index([locale, updatedAt])
}