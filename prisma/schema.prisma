// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String   @unique
  password            String
  role                String   @default("user") // "user" or "admin"
  isBlocked           Boolean  @default(false)
  isActive            Boolean  @default(false) // Usuário precisa ser liberado manualmente
  accessExpiresAt     DateTime? // Data de expiração do acesso (1 mês após liberação)
  passwordResetRequired Boolean @default(false) // Flag para indicar que senha precisa ser redefinida
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  conversations Conversation[]

  @@map("users")
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  String   // JSON array de mensagens
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
  @@index([userId])
}
