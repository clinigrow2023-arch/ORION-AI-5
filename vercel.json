{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth-register", "destination": "/api/auth" },
    { "source": "/api/auth-login", "destination": "/api/auth" },
    { "source": "/api/auth-verify", "destination": "/api/auth" },
    { "source": "/api/change-password", "destination": "/api/auth" },
    { "source": "/api/set-new-password", "destination": "/api/auth" },
    { "source": "/api/admin-users", "destination": "/api/admin-users" },
    { "source": "/api/conversations", "destination": "/api/conversations" },
    { "source": "/api/digistore-ipn", "destination": "/api/digistore-ipn" },
    { "source": "/api/system-prompt", "destination": "/api/system-prompt" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/plan", "destination": "/api/plan" },
    { "source": "/api/gemini", "destination": "/api/chat" }
  ],
  "env": {
    "PRISMA_GENERATE_DATABASE_URL": "mongodb://localhost:27017/dummy"
  }
}
